{
  "info": {
    "name": "ShopCloud - Flujo completo",
    "description": "Ejecutar en orden. Los tokens e IDs se guardan solos en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenPropietario",
      "value": ""
    },
    {
      "key": "correoPropietario",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "tiendaId",
      "value": ""
    },
    {
      "key": "slug",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "metodoPagoId",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "direccionId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Propietario prepara su tienda (prueba gratuita)",
      "item": [
        {
          "name": "1.1 Ver planes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/planes",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const plan = pm.response.json().find(p => p.nombre === \"Emprendedor\");",
                  "pm.collectionVariables.set(\"planId\", plan.id);",
                  "pm.test(\"Existen los 3 planes\", () => pm.expect(pm.response.json().length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Registrar propietario",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/registro",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jesus\",\n  \"correoElectronico\": \"{{correoPropietario}}\",\n  \"contrasena\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tokenPropietario\", pm.response.json().token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correoPropietario\", `jesus${Date.now()}@prueba.pe`);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Crear tienda (inicia 7 días de prueba)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/tiendas",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mi Tienda\",\n  \"slug\": \"mi-tienda\",\n  \"planId\": \"{{planId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tiendaId\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"slug\", pm.response.json().slug);",
                  "pm.test(\"Es una prueba\", () => pm.expect(pm.response.json().suscripcionTipo).to.eql(\"PRUEBA\"));",
                  "pm.test(\"Se puede administrar\", () => pm.expect(pm.response.json().administrable).to.eql(true));",
                  "pm.test(\"Aún no está publicada\", () => pm.expect(pm.response.json().publicada).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/categorias",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Polos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"categoriaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Crear producto (S/ 59)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Polo\",\n  \"precio\": 59.0,\n  \"categoriaId\": \"{{categoriaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Registrar 10 unidades",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/inventario",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{productoId}}\",\n  \"cantidad\": 10,\n  \"cantidadMinima\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Crear método de pago",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/gestion/metodos-pago",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Yape\",\n  \"tipo\": \"YAPE\",\n  \"instrucciones\": \"Yapea al 999 999 999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"metodoPagoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 El público NO ve la tienda en prueba",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/publico/tiendas/{{slug}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Tienda no disponible\", () => pm.expect(pm.response.json().codigo).to.eql(\"TIENDA_NO_DISPONIBLE\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Propietario contrata y publica",
      "item": [
        {
          "name": "2.1 Contratar plan (pago simulado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/suscripciones/contratar",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Es pagada\", () => pm.expect(pm.response.json().tipo).to.eql(\"PAGADA\"));",
                  "pm.test(\"Monto del plan\", () => pm.expect(pm.response.json().montoPagado).to.eql(29));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Ahora el público ve el catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/publico/tiendas/{{slug}}/productos",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Muestra el producto\", () => pm.expect(pm.response.json()[0].nombre).to.eql(\"Polo\"));",
                  "pm.test(\"Muestra el stock\", () => pm.expect(pm.response.json()[0].stock).to.eql(10));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cliente compra",
      "item": [
        {
          "name": "3.1 Registrar cliente en la tienda",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/publico/tiendas/{{slug}}/clientes/registro",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"correoElectronico\": \"ana@prueba.pe\",\n  \"contrasena\": \"clave12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Agregar dirección",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/mi-cuenta/direcciones",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lineaDireccion\": \"Av. Arequipa 123\",\n  \"ciudad\": \"Lima\",\n  \"distrito\": \"Lince\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"direccionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Agregar 2 polos al carrito",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/carrito/productos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{productoId}}\",\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Total del carrito\", () => pm.expect(pm.response.json().total).to.eql(118));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Ver resumen con IGV",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/checkout/resumen",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Base imponible\", () => pm.expect(pm.response.json().baseImponible).to.eql(100));",
                  "pm.test(\"IGV\", () => pm.expect(pm.response.json().montoIgv).to.eql(18));",
                  "pm.test(\"Total\", () => pm.expect(pm.response.json().total).to.eql(118));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Comprar con boleta",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/checkout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccionId\": \"{{direccionId}}\",\n  \"metodoPagoId\": \"{{metodoPagoId}}\",\n  \"numeroDocumento\": \"12345678\",\n  \"nombreRazonSocial\": \"Ana Perez\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);",
                  "pm.test(\"Pedido confirmado\", () => pm.expect(pm.response.json().estado).to.eql(\"CONFIRMADO\"));",
                  "pm.test(\"Total\", () => pm.expect(pm.response.json().total).to.eql(118));",
                  "pm.test(\"Base imponible\", () => pm.expect(pm.response.json().baseImponible).to.eql(100));",
                  "pm.test(\"IGV\", () => pm.expect(pm.response.json().montoIgv).to.eql(18));",
                  "pm.test(\"Boleta\", () => pm.expect(pm.response.json().comprobante.tipo).to.eql(\"BOLETA\"));",
                  "pm.test(\"Pago registrado\", () => pm.expect(pm.response.json().transaccion.estado).to.eql(\"REALIZADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Ver mis pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tiene un pedido\", () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Propietario gestiona la venta",
      "item": [
        {
          "name": "4.1 Ver stock (bajó a 8)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/inventario",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Quedan 8\", () => pm.expect(pm.response.json()[0].cantidad).to.eql(8));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Ver pedidos de la tienda",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/gestion/pedidos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Aparece la venta\", () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Pasar pedido a PREPARANDO",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/gestion/pedidos/{{pedidoId}}/estado",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PREPARANDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado nuevo\", () => pm.expect(pm.response.json().estado).to.eql(\"PREPARANDO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 Ver estadísticas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tiendaId}}"
              }
            ],
            "url": "{{baseUrl}}/api/analitica/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPropietario}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Ventas\", () => pm.expect(pm.response.json().ventasTotales).to.eql(118));",
                  "pm.test(\"Unidades\", () => pm.expect(pm.response.json().productosVendidos).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Comprobar la seguridad (estos errores son correctos)",
      "item": [
        {
          "name": "5.1 Sin sesión: 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tiendas/mis-tiendas",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Propietario sin X-Tenant-ID: 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos",
