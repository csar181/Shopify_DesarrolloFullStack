# Variables que necesita el backend. Spring Boot no carga este archivo por sí solo:
# defínelas en el sistema operativo o en la configuración de ejecución del IDE.

# Obligatorias
DB_PASSWORD=
# Clave en Base64 de al menos 32 bytes. Ejemplo: openssl rand -base64 48
JWT_SECRET=

# Opcionales (se muestran sus valores por defecto)
DB_URL=jdbc:postgresql://localhost:5432/shopcloud_test
DB_USERNAME=postgres
SHOW_SQL=false
